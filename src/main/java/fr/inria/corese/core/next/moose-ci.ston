MooseCIConfig {
	#projectLanguage : #java,
	#metrics : [
		#packages,
		#classes
	],
	#rules : [
		#too_many_parameters : {
			#parameters : 10
		},
		#large_class : {
			#attributes : 15,
			#methods : 20
		},
		#corese_unused_local_variable,
		#unused_parameter
	],
	#outputFormats : [
		#json, #html
	],
	#outputPath : '.moose-ci/report',
	#visualizations : [
		{ #view : #architecturalMap, #of : #packages, #in : '.*\\.next\\..+', #settings : { #layout : #tree } },
		{ #view : #dsm, #of : #packages, #in : '.*\\.next\\.query\\.impl\\.engine\\.[^.]+' },
		{ #view : #dsm, #of : #packages, #in : '.*\\.next\\.query\\.impl\\.sparql\\.[^.]+' },
		{ #view : #dsm, #of : #classes, #in : '.*\\.sparql\\.parser\\.listener\\.[^.]+' }
	],
	#isRemote : false
}